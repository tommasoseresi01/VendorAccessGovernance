@model List<VendorAccessGovernance.Application.DTOs.AccessRequestDto>

@{
    ViewData["Title"] = "Richieste di accesso";

    (string Title, string? Subtitle, string? PrimaryActionText, string? PrimaryActionUrl) headerModel =
    (
        Title: "Richieste di accesso",
        Subtitle: "Gestione accessi fornitori / visitatori",
        PrimaryActionText: "Nuova richiesta",
        PrimaryActionUrl: Url.Action("Create", "AccessRequests")
    );
}

@await Html.PartialAsync("_PageHeader", headerModel)

@if (!Model.Any())
{
    <div class="text-center py-5 text-muted">
        <p class="mb-3">Nessuna richiesta di accesso trovata.</p>
        <a asp-action="Create" class="btn btn-primary">Crea la prima richiesta</a>
    </div>
}
else
{
    <table class="table table-hover align-middle shadow-sm bg-white">
        <thead>
            <tr>
                <th>#</th>
                <th>Lavoratore</th>
                <th>Vendor</th>
                <th>Motivo</th>
                <th>Periodo</th>
                <th>Sponsor interno</th>
                <th>Stato</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                var statusClass = item.Status switch
                {
                    "PendingApproval" => "badge-status pending",
                    "Approved" => "badge-status approved",
                    "Rejected" => "badge-status rejected",
                    _ => "badge-status"
                };

                <tr>
                    <td>@item.Id</td>
                    <td>@item.WorkerFullName</td>
                    <td>@item.VendorName</td>
                    <td>@item.Reason</td>
                    <td>
                        @item.StartDateTime.ToString("g")<br />
                        <span class="text-muted small">→ @item.EndDateTime.ToString("g")</span>
                    </td>
                    <td>@item.InternalSponsor</td>
                    <td>
                        <span class="@statusClass">@item.Status</span>
                    </td>
                    <td>
                        <div class="d-flex gap-2 justify-content-end">
                            <a asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-secondary">
                                Dettagli
                            </a>
                            <a asp-action="UpdateStatus"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-primary">
                                Aggiorna stato
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}