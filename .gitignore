## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Visual Studio folders
.vs/
.idea/
.vscode/

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# .NET / ASP.NET Core
*.dll
*.exe
*.pdb
*.cache
*.dbmdl
*.jfm
*.publishsettings
publish/
wwwroot/lib/

# Rider / ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# Test results
[Tt]est[Rr]esult*/
[Bb]enchmark[Dd]ot[Nn]et.Artifacts/

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# npm / frontend
node_modules/
dist/
coverage/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# SQL / local db
*.mdf
*.ldf

# Logs
*.log

# Environment / secrets
.env
.env.*
secrets.json
appsettings.Development.json

# Certificates
*.pfx
*.pem
*.key

# Generated files
Generated/
artifacts/

# EF Core local tooling artifacts
*.db